<div class="chat-window">
    <div class="chat-header">
        <h2>{{chatName}}</h2>
    </div>
    <div class="chat-messages">
        {{#each messages}}
            <div class="message {{#if isOwn}}own{{else}}other{{/if}}">
                <p>{{text}}</p>
                <span>{{time}}</span>
            </div>
        {{/each}}
    </div>
</div>