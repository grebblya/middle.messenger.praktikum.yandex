<div class="form-group">
            <label for="{{passwordType}}">{{text}}</label>
            <div class="password-input-wrapper">
                <input type="password" id="{{passwordType}}" name="{{passwordType}}" class="form-control" placeholder="{{text}}" required>
                <i class="password-toggle-icon" id="{{PasswordToggleType}}">👁️</i>
            </div>
            <div id="{{passwordError}}" class="error-message"></div>
        </div>